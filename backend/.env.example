# ==============================================================================
# Variáveis de Ambiente - Exemplo (.env.example)
# Descrição: Define as variáveis de ambiente necessárias para a execução da API,
# incluindo porta do servidor, conexão com banco de dados, chaves de autenticação
# JWT e credenciais de serviço de e-mail (SMTP).
# ==============================================================================

PORT=3000
NODE_ENV=development

# Configuração do Banco de Dados (Supabase PostgreSQL)
# Conexão Pooler IPv4 (Recomendado para conexões locais e IPv4 - Porta 5432 Session Mode):
DATABASE_URL="postgresql://postgres.upwdbhdbsyxjdwqumgql:82937061eve7iE%40@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Conexão Pooler Transaction Mode (Porta 6543):
DATABASE_URL_POOL="postgresql://postgres.upwdbhdbsyxjdwqumgql:82937061eve7iE%40@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão Direta (Requer rede IPv6):
DIRECT_URL="postgresql://postgres:82937061eve7iE%40@db.upwdbhdbsyxjdwqumgql.supabase.co:5432/postgres"

# Autenticação JWT
JWT_SECRET=seu_segredo_jwt_aqui
JWT_EXPIRES_IN=1d

# Serviço de E-mail (Alertas e Notificações)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=alerta@exemplo.com
SMTP_PASS=senha_smtp
SMTP_FROM="QCAcesso <nao-responda@exemplo.com>"
