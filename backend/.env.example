PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# URL e chave PUBLICÁVEL (ou anon) em Project Settings > API.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Alternativa legada: SUPABASE_ANON_KEY=...
# Não use service_role/secret key para o login da aplicação.
SESSION_TTL_HOURS=8
# Jobs de alertas desligados até configurar a credencial administrativa e o SMTP.
ALERTS_ENABLED=false
ALERTS_TIMEZONE=America/Sao_Paulo
# Use somente no processo backend; nunca use essa chave nos clientes web.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUBSTITUA
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=senha-smtp
ALERTS_FROM_EMAIL=qcacesso@exemplo.com
# Opcional: somente para npm run test:db (não necessário para a API).
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@POOLER_HOST:5432/postgres"
# CA do Supabase (Database Settings > SSL Configuration > Download certificate).
DATABASE_SSL_CA=./certs/supabase-prod-ca.crt
